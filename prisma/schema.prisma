// =============================================================================
// DivergenCIE — Sandbox Prisma Schema v6.0
// Ground Truth: DC Database 2026.xlsx + UJM v6.0
// decisions: Q1–Q21 locked.
// Engine: SQLite (dev) / PostgreSQL (prod) — syntax compatible with both
// =============================================================================



generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── CLUSTER 1 — USERS & PROFILES ───────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  role                String?
  dept                String?
  supervisor          Boolean              @default(false)
  passwordHash        String?
  photo               String?
  bio                 String?
  isActive            Boolean              @default(true)
  active              Boolean              @default(true)
  subGroup            String?
  referralCode        String?              @unique
  whatsappNumber      String?
  country             String?
  phone               String?
  grade               String?
  board               String?
  targetUni           String?
  specialization      String?
  hourlyRate          Float?
  createdAt           DateTime             @default(now())

  // Parent–student self-join
  parentId            String?
  parent              User?                @relation("ParentStudent", fields: [parentId], references: [id])
  children            User[]               @relation("ParentStudent")

  // Profile relations (one per role, all optional)
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  staffProfile        StaffProfile?
  parentProfile       ParentProfile?
  ambassadorProfile   AmbassadorProfile?

  // Bank accounts
  bankAccounts        BankAccount[]

  // Tickets
  ticketsCreated      Ticket[]             @relation("TicketCreator")
  ticketsAssigned     Ticket[]             @relation("TicketAssignee")
  ticketMessages      TicketMessage[]
  ticketHistory       TicketHistory[]

  // Meetings & Events
  meetingParticipants MeetingParticipant[]
  calendarItems       CalendarItem[]

  // Other CRM logs
  siteLogs            SiteLog[]
  studentFlags        StudentFlag[]        @relation("FlaggedUser")
  studentFlagsCreated StudentFlag[]        @relation("FlagCreator")
  accessLogs          AccessLog[]
  contentBankItems    ContentBankItem[]

  // Records
  studentRecords      StudentRecord[]      @relation("StudentRecordUser")
  studentRecordsIssue StudentRecord[]      @relation("StudentRecordIssuer")
  teacherRecords      TeacherRecord[]      @relation("TeacherRecordUser")
  teacherRecordsIssue TeacherRecord[]      @relation("TeacherRecordIssuer")
  staffRecords        StaffRecord[]        @relation("StaffRecordUser")
  staffRecordsIssued  StaffRecord[]        @relation("StaffRecordIssuer")
  ambassadorRecords   AmbassadorRecord[]   @relation("AmbassadorRecordUser")
  ambassadorRecordIss AmbassadorRecord[]   @relation("AmbassadorRecordIssuer")

  // Enrollments
  studentEnrolmentLists    StudentEnrolmentList[]
  teacherEnrolmentLists    TeacherEnrolmentList[]
  staffEnrolmentLists      StaffEnrolmentList[]
  ambassadorEnrolmentLists AmbassadorEnrolmentList[]
  ambassadorCommissionLists AmbassadorCommissionList[]

  // Accounting & Billings
  studentInvoices     StudentInvoice[]
  paymentRecords      PaymentRecord[]
  claims              Claim[]
  paychecks           Paycheck[]           @relation("PaycheckRecipient")
  ambassadorClaims    AmbassadorClaim[]
  ambassadorPaychecks AmbassadorPaycheck[]

  // Services & Academics
  services            Service[]
  taughtSessions      AcademicSession[]    @relation("TeacherSessions")
  taughtGroups        Group[]              @relation("GroupTeacher")
  studentSessions     AcademicSession[]    @relation("StudentSessions")
  attendances         SessionAttendance[]
  taskAssignments     TaskAssignment[]
  taskSubmissions     TaskSubmission[]
  mockResults         MockResult[]
  doubts              Doubt[]
  studentProgress     StudentProgress[]
  assignments         Assignment[]
  groups              Group[]              @relation("GroupStudents")
  ambassadorProgrammeProgress AmbassadorProgrammeProgress[]
  referrals           Referral[]           @relation("Referrer")
  ambassadorTestRes   AmbassadorTestResult[]
  checklistEntries    ChecklistEntry[]

  @@index([isActive])
}

model StudentProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String    @default("ACTIVE") // "ACTIVE" | "PAUSED" | "CANCELLED" | "COMPLETED"
  firstName             String?
  lastName              String?
  school                String?
  whatsappNumber        String?
  parentWhatsappNumber  String?
  gcrLink               String?
  location              String?
  mainCurrency          String?
  timeZone              String?
  notes                 String?
  referredBy            String?
  timesheetURL          String?
  scheduleURL           String?
  progressTrackerURL    String?
  gcrAssigned           Boolean   @default(false)
  groupAssigned         Boolean   @default(false)
  scheduleAssigned      Boolean   @default(false)
  financeApprovedFlag   Boolean   @default(false)
  registrationDate      DateTime  @default(now())
  cancellationReason    String?
  dob                   DateTime?
  grade                 String?
  board                 String?
}

model TeacherProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String?
  lastName              String?
  teachingProfileUrl    String?
  idDocProvided         Boolean   @default(false)
  salaryAccountProvided Boolean   @default(false)
}

model StaffProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String    @default("ACTIVE") // "ACTIVE" | "PAUSED" | "CANCELLED" | "COMPLETED"
  roleTitle             String?
  salaryType            String?
  salaryRate            Float?
  role                  String?
  dept                  String?
  isSupervisor          Boolean   @default(false)
  registrationDate      DateTime  @default(now())
  departedAt            DateTime?
  departureReason       String?
}

model ParentProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                 String?
  address               String?
}

model AmbassadorProfile {
  id              String                  @id @default(cuid())
  userId          String                  @unique
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort          String?
  referralCode    String?                 @unique
  programmeDuration String?
  programmeStart  DateTime?
  programmeEnd    DateTime?
  completionStatus String?
  certificateLink String?
  linkedInBadgeLink String?

  deliverables    AmbassadorDeliverable[]
  earnings        AmbassadorEarning[]
}

// ─── CLUSTER 2 — PRE-HIRE PIPELINE ──────────────────────────────────────────

model Candidate {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  candidateType        String?   // "TEACHER" | "STAFF" | "AMBASSADOR" | "STUDENT"
  role                 String
  status               String    @default("APPLIED") // "APPLIED" | "SCREENING" etc.
  cvLink               String?
  docsLink             String?
  notes                String?
  outreachSource       String?
  outreachStatus       String?
  trialTaskLink        String?
  interviewAt          DateTime?
  convertedToUserId    String?
  isActive             Boolean   @default(true)
  outreach             String?
  skills               String?
  extraSkills          String?
  qualifications       String?
  expectedRate         String?
  timeZone             String?
  interviewTime        String?
  startDate            DateTime?
  offerLetterStatus    String?
  gcrAccess            String?
  classSchedule        String?
  workFolder           String?
  interviewRequestedAt DateTime?

  registrationEntries  RegistrationFormEntry[]
}

// ─── CLUSTER 3 — SESSION TYPES ──────────────────────────────────────────────

model SessionType {
  id                   String    @id @default(cuid())
  name                 String    @unique // "CLASS" | "MOCK" | "TRIAL" | "EXAM"
  isActive             Boolean   @default(true)

  scheduleOccurrences  ScheduleOccurrence[]
  staffOccurrences     StaffScheduleOccurrence[]
  ambassadorOccurrences AmbassadorScheduleOccurrence[]
  academicSessions     AcademicSession[]
  meetings             Meeting[]
  ambassadorMeetings   AmbassadorMeeting[]
  generalMeetings      GeneralMeeting[]
}

// ─── CLUSTER 4 — GROUPS & SERVICES ──────────────────────────────────────────

model Group {
  id            String            @id @default(cuid())
  code          String            @unique // "B8", "C14"
  groupCategory String            // "B_GROUP" | "C_GROUP" | "T_GROUP"
  status        String            @default("active")
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  teacherId     String?
  teacher       User?             @relation("GroupTeacher", fields: [teacherId], references: [id])
  students      User[]            @relation("GroupStudents")
  subject       String?

  services      Service[]
  sessions      AcademicSession[]
}

model Service {
  id                    String            @id @default(cuid())
  groupId               String?
  group                 Group?            @relation(fields: [groupId], references: [id])
  teacherId             String
  teacher               User              @relation(fields: [teacherId], references: [id])
  board                 String?
  courseLevel           String?
  subjectCode           String?
  subjectName           String
  fullSubjectName       String?
  standardRate          Float?
  instructorNameSnapshot String?
  serviceType           String            // "HOURLY_FIXED" | "HOURLY_FLEXIBLE" | "MONTHLY" | "ONE_OFF"
  isHourly              Boolean           @default(false)
  teacherIdSnapshot     String?
  isActive              Boolean           @default(true)
  currency              String?

  rateList              RateList?
  studentEnrolmentItems StudentEnrolmentItem[]
  teacherEnrolmentItems TeacherEnrolmentItem[]
  serviceSchedules      ServiceSchedule[]
  academicSessions      AcademicSession[]
  attendances           SessionAttendance[]
  recordings            Recording[]
  curriculumLists       CurriculumList[]
  taskItems             TaskItem[]
  mockItems             MockItem[]
  assignments           Assignment[]
  mockResults           MockResult[]
  claimLineItems        ClaimLineItem[]
}

// ─── CLUSTER 5 — RATE SYSTEM ────────────────────────────────────────────────

model RateList {
  id              String      @id @default(cuid())
  serviceId       String      @unique
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isActive        Boolean     @default(true)

  rateItems       RateItem[]
}

model RateItem {
  id              String                  @id @default(cuid())
  rateListId      String
  rateList        RateList                @relation(fields: [rateListId], references: [id], onDelete: Cascade)
  country         String                  // "MY" | "IN" | "PK" | "GB" | "SA" | "DEFAULT"
  currency        String
  clientRate      Float
  staffRate       Float?
  status          String                  @default("ACTIVE") // "ACTIVE" | "PAUSED" | "INACTIVE"
  activatedAt     DateTime                @default(now())
  pausedAt        DateTime?
  deactivatedAt   DateTime?
  isActive        Boolean                 @default(true)

  history         RateItemStatusHistory[]
  changes         RateChangeLog[]
}

model RateItemStatusHistory {
  id              String    @id @default(cuid())
  rateItemId      String
  rateItem        RateItem  @relation(fields: [rateItemId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime  @default(now())
  changedByUserId String
  reason          String?
}

model RateChangeLog {
  id                  String    @id @default(cuid())
  rateItemId          String
  rateItem            RateItem  @relation(fields: [rateItemId], references: [id], onDelete: Cascade)
  previousClientRate  Float
  newClientRate       Float
  previousStaffRate   Float?
  newStaffRate        Float?
  changedAt           DateTime  @default(now())
  changedByUserId     String
  reason              String?
}

// ─── CLUSTER 6 — STUDENT ENROLMENT ──────────────────────────────────────────

model StudentEnrolmentList {
  id              String                 @id @default(cuid())
  studentId       String
  student         User                   @relation(fields: [studentId], references: [id])
  serviceType     String
  isActive        Boolean                @default(true)

  items           StudentEnrolmentItem[]
}

model StudentEnrolmentItem {
  id                    String            @id @default(cuid())
  enrolmentListId       String
  enrolmentList         StudentEnrolmentList @relation(fields: [enrolmentListId], references: [id], onDelete: Cascade)
  studentId             String
  serviceId             String
  service               Service           @relation(fields: [serviceId], references: [id])
  status                String            @default("ACTIVE") // "TRIAL" | "ACTIVE" | "CANCELLED"
  trialRequired         Boolean           @default(false)
  startDate             DateTime?
  endDate               DateTime?
  expectedHoursPerMonth Float?
  activatedAt           DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?
  cancellationReason    String?
  isActive              Boolean           @default(true)

  history               StudentEnrolmentItemStatusHistory[]
  discounts             Discount[]
  attendances           SessionAttendance[]
  invoiceLineItems      InvoiceLineItem[]
  commissionItems       AmbassadorCommissionItem[]
}

model StudentEnrolmentItemStatusHistory {
  id              String                @id @default(cuid())
  enrolmentItemId String
  enrolmentItem   StudentEnrolmentItem  @relation(fields: [enrolmentItemId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime              @default(now())
  changedByUserId String
  reason          String?
}

model Discount {
  id              String                @id @default(cuid())
  studentId       String
  enrolmentItemId String?
  enrolmentItem   StudentEnrolmentItem? @relation(fields: [enrolmentItemId], references: [id])
  discountType    String
  value           Float
  isPct           Boolean               @default(true)
  code            String?
  isActive        Boolean               @default(true)
}

// ─── CLUSTER 7 — TEACHER ENROLMENT ──────────────────────────────────────────

model TeacherEnrolmentList {
  id              String                 @id @default(cuid())
  teacherId       String
  teacher         User                   @relation(fields: [teacherId], references: [id])
  serviceType     String
  isActive        Boolean                @default(true)

  items           TeacherEnrolmentItem[]
}

model TeacherEnrolmentItem {
  id                    String            @id @default(cuid())
  enrolmentListId       String
  enrolmentList         TeacherEnrolmentList @relation(fields: [enrolmentListId], references: [id], onDelete: Cascade)
  teacherId             String
  serviceId             String
  service               Service           @relation(fields: [serviceId], references: [id])
  status                String            @default("ACTIVE")
  trialRequired         Boolean           @default(false)
  startDate             DateTime?
  endDate               DateTime?
  activatedAt           DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?
  cancellationReason    String?
  isActive              Boolean           @default(true)

  history               TeacherEnrolmentItemStatusHistory[]
}

model TeacherEnrolmentItemStatusHistory {
  id              String                @id @default(cuid())
  enrolmentItemId String
  enrolmentItem   TeacherEnrolmentItem  @relation(fields: [enrolmentItemId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime              @default(now())
  changedByUserId String
  reason          String?
}

// ─── CLUSTER 8 — STAFF ENROLMENT ────────────────────────────────────────────

model StaffEnrolmentList {
  id              String                 @id @default(cuid())
  staffId         String
  staff           User                   @relation(fields: [staffId], references: [id])
  serviceType     String
  isActive        Boolean                @default(true)

  items           StaffEnrolmentItem[]
}

model StaffEnrolmentItem {
  id                    String            @id @default(cuid())
  enrolmentListId       String
  enrolmentList         StaffEnrolmentList @relation(fields: [enrolmentListId], references: [id], onDelete: Cascade)
  staffId               String
  staffServiceId        String            // linked conceptually
  status                String            @default("ACTIVE")
  trialRequired         Boolean           @default(false)
  startDate             DateTime?
  endDate               DateTime?
  expectedHoursPerMonth Float?
  activatedAt           DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?
  cancellationReason    String?
  isActive              Boolean           @default(true)

  history               StaffEnrolmentItemStatusHistory[]
  meetingAttendances    MeetingAttendance[]
}

model StaffEnrolmentItemStatusHistory {
  id              String                @id @default(cuid())
  enrolmentItemId String
  enrolmentItem   StaffEnrolmentItem    @relation(fields: [enrolmentItemId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime              @default(now())
  changedByUserId String
  reason          String?
}

// ─── CLUSTER 9 — AMBASSADOR ENROLMENT & COMMISSION ──────────────────────────

model AmbassadorEnrolmentList {
  id              String                 @id @default(cuid())
  ambassadorId    String
  ambassador      User                   @relation(fields: [ambassadorId], references: [id])
  serviceType     String
  isActive        Boolean                @default(true)

  items           AmbassadorEnrolmentItem[]
}

model AmbassadorEnrolmentItem {
  id                    String            @id @default(cuid())
  enrolmentListId       String
  enrolmentList         AmbassadorEnrolmentList @relation(fields: [enrolmentListId], references: [id], onDelete: Cascade)
  ambassadorId          String
  ambassadorServiceId   String
  status                String            @default("ACTIVE")
  trialRequired         Boolean           @default(false)
  startDate             DateTime?
  endDate               DateTime?
  activatedAt           DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?
  cancellationReason    String?
  isActive              Boolean           @default(true)

  history               AmbassadorEnrolmentItemStatusHistory[]
  meetingAttendances    AmbassadorMeetingAttendance[]
}

model AmbassadorEnrolmentItemStatusHistory {
  id              String                  @id @default(cuid())
  enrolmentItemId String
  enrolmentItem   AmbassadorEnrolmentItem @relation(fields: [enrolmentItemId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime                @default(now())
  changedByUserId String
  reason          String?
}

model AmbassadorCommissionList {
  id              String                     @id @default(cuid())
  ambassadorId    String
  ambassador      User                       @relation(fields: [ambassadorId], references: [id])
  isActive        Boolean                    @default(true)

  items           AmbassadorCommissionItem[]
}

model AmbassadorCommissionItem {
  id                    String            @id @default(cuid())
  commissionListId      String
  commissionList        AmbassadorCommissionList @relation(fields: [commissionListId], references: [id], onDelete: Cascade)
  studentEnrolmentItemId String
  studentEnrolmentItem   StudentEnrolmentItem @relation(fields: [studentEnrolmentItemId], references: [id])
  commissionPct         Float
  status                String            @default("ACTIVE")
  activatedAt           DateTime          @default(now())
  pausedAt              DateTime?
  deactivatedAt         DateTime?
  isActive              Boolean           @default(true)

  history               AmbassadorCommissionItemStatusHistory[]
  changes               AmbassadorCommissionRateChangeLog[]
}

model AmbassadorCommissionItemStatusHistory {
  id              String                    @id @default(cuid())
  commissionItemId String
  commissionItem  AmbassadorCommissionItem  @relation(fields: [commissionItemId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime                  @default(now())
  changedByUserId String
  reason          String?
}

model AmbassadorCommissionRateChangeLog {
  id              String                    @id @default(cuid())
  commissionItemId String
  commissionItem  AmbassadorCommissionItem  @relation(fields: [commissionItemId], references: [id], onDelete: Cascade)
  previousPct     Float
  newPct          Float
  changedAt       DateTime                  @default(now())
  changedByUserId String
  reason          String?
}

// ─── CLUSTER 10 — SCHEDULES (STUDENT) ───────────────────────────────────────

model ServiceSchedule {
  id              String      @id @default(cuid())
  serviceId       String      @unique
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isActive        Boolean     @default(true)

  occurrences     ScheduleOccurrence[]
  changeRequests  ScheduleChangeRequest[]
}

model ScheduleOccurrence {
  id              String              @id @default(cuid())
  scheduleId      String
  schedule        ServiceSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sessionTypeId   String
  sessionType     SessionType         @relation(fields: [sessionTypeId], references: [id])
  recurrenceType  String              // "WEEKLY" | "BIWEEKLY" | "ONE_OFF" etc.
  dayOfWeek       String?
  dayOfMonth      Int?
  monthOfYear     String?
  oneOffDate      DateTime?
  customPattern   String?
  startTime       DateTime
  endTime         DateTime
  durationHours   Float
  status          String              @default("ACTIVE")
  activatedAt     DateTime            @default(now())
  pausedAt        DateTime?
  deactivatedAt   DateTime?
  isActive        Boolean             @default(true)

  history         ScheduleOccurrenceStatusHistory[]
}

model ScheduleOccurrenceStatusHistory {
  id              String              @id @default(cuid())
  occurrenceId    String
  occurrence      ScheduleOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime            @default(now())
  changedByUserId String
  reason          String?
}

model ScheduleChangeRequest {
  id                    String          @id @default(cuid())
  scheduleId            String
  schedule              ServiceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  occurrenceId          String?
  requestedByUserId     String
  requestType           String          // "ADD" | "REMOVE" | "RESCHEDULE"
  recurrenceType        String
  proposedDayOfWeek     String?
  proposedStartTime     DateTime?
  proposedEndTime       DateTime?
  proposedDuration      Float?
  proposedSessionTypeId String?
  status                String          @default("PENDING")
  rejectionReason       String?
  resolvedAt            DateTime?
  resolvedByUserId      String?
}

// ─── CLUSTER 10B — SCHEDULES (STAFF) ────────────────────────────────────────

model StaffServiceSchedule {
  id              String      @id @default(cuid())
  staffServiceId  String      @unique
  isActive        Boolean     @default(true)

  occurrences     StaffScheduleOccurrence[]
  changeRequests  StaffScheduleChangeRequest[]
}

model StaffScheduleOccurrence {
  id              String              @id @default(cuid())
  scheduleId      String
  schedule        StaffServiceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sessionTypeId   String
  sessionType     SessionType         @relation(fields: [sessionTypeId], references: [id])
  recurrenceType  String
  dayOfWeek       String?
  dayOfMonth      Int?
  monthOfYear     String?
  oneOffDate      DateTime?
  customPattern   String?
  startTime       DateTime
  endTime         DateTime
  durationHours   Float
  status          String              @default("ACTIVE")
  activatedAt     DateTime            @default(now())
  pausedAt        DateTime?
  deactivatedAt   DateTime?
  isActive        Boolean             @default(true)

  history         StaffScheduleOccurrenceStatusHistory[]
}

model StaffScheduleOccurrenceStatusHistory {
  id              String                  @id @default(cuid())
  occurrenceId    String
  occurrence      StaffScheduleOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime                @default(now())
  changedByUserId String
  reason          String?
}

model StaffScheduleChangeRequest {
  id                    String              @id @default(cuid())
  scheduleId            String
  schedule              StaffServiceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  occurrenceId          String?
  requestedByUserId     String
  requestType           String
  recurrenceType        String
  proposedDayOfWeek     String?
  proposedStartTime     DateTime?
  proposedEndTime       DateTime?
  proposedDuration      Float?
  proposedSessionTypeId String?
  status                String              @default("PENDING")
  rejectionReason       String?
  resolvedAt            DateTime?
  resolvedByUserId      String?
}

// ─── CLUSTER 10C — SCHEDULES (AMBASSADOR) ───────────────────────────────────

model AmbassadorServiceSchedule {
  id                    String      @id @default(cuid())
  ambassadorServiceId   String      @unique
  isActive              Boolean     @default(true)

  occurrences           AmbassadorScheduleOccurrence[]
  changeRequests        AmbassadorScheduleChangeRequest[]
}

model AmbassadorScheduleOccurrence {
  id              String              @id @default(cuid())
  scheduleId      String
  schedule        AmbassadorServiceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sessionTypeId   String
  sessionType     SessionType         @relation(fields: [sessionTypeId], references: [id])
  recurrenceType  String
  dayOfWeek       String?
  dayOfMonth      Int?
  monthOfYear     String?
  oneOffDate      DateTime?
  customPattern   String?
  startTime       DateTime
  endTime         DateTime
  durationHours   Float
  status          String              @default("ACTIVE")
  activatedAt     DateTime            @default(now())
  pausedAt        DateTime?
  deactivatedAt   DateTime?
  isActive        Boolean             @default(true)

  history         AmbassadorScheduleOccurrenceStatusHistory[]
}

model AmbassadorScheduleOccurrenceStatusHistory {
  id              String                        @id @default(cuid())
  occurrenceId    String
  occurrence      AmbassadorScheduleOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime                      @default(now())
  changedByUserId String
  reason          String?
}

model AmbassadorScheduleChangeRequest {
  id                    String                    @id @default(cuid())
  scheduleId            String
  schedule              AmbassadorServiceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  occurrenceId          String?
  requestedByUserId     String
  requestType           String
  recurrenceType        String
  proposedDayOfWeek     String?
  proposedStartTime     DateTime?
  proposedEndTime       DateTime?
  proposedDuration      Float?
  proposedSessionTypeId String?
  status                String                    @default("PENDING")
  rejectionReason       String?
  resolvedAt            DateTime?
  resolvedByUserId      String?
}

// ─── CLUSTER 11 — ACADEMIC SESSIONS ─────────────────────────────────────────

model AcademicSession {
  id                        String       @id @default(cuid())
  groupId                   String?
  group                     Group?       @relation(fields: [groupId], references: [id])
  teacherId                 String
  teacher                   User         @relation("TeacherSessions", fields: [teacherId], references: [id])
  serviceId                 String?
  service                   Service?     @relation(fields: [serviceId], references: [id])
  studentId                 String?
  student                   User?        @relation("StudentSessions", fields: [studentId], references: [id])
  subject                   String?
  serviceScheduleId         String?
  occurrenceId              String?
  scheduledByUserId         String?
  sessionTypeId             String?
  sessionType               SessionType? @relation(fields: [sessionTypeId], references: [id])
  topic                     String?
  startTime                 DateTime
  endTime                   DateTime
  originalStartTime         DateTime?
  originalEndTime           DateTime?
  durationHours             Float        @default(1.0)
  isTrial                   Boolean      @default(false)
  status                    String       @default("SCHEDULED") // "SCHEDULED" | "COMPLETED" | "CANCELLED"
  sessionMode               String       @default("SCHEDULED")
  zoomLink                  String?
  zoomId                    String?
  zoomPasscode              String?
  addedToCalendar           Boolean      @default(false)
  calendarSyncedAt          DateTime?
  recordingUrl              String?
  transcriptUrl             String?
  summaryUrl                String?
  wbLink                    String?
  wbName                    String?
  timesheetSubmissionStatus String       @default("pending")
  submissionDeadline        DateTime?
  submissionOverdue         Boolean      @default(false)

  attendances               SessionAttendance[]
  recordings                Recording[]
  taskItems                 TaskItem[]
  mockItems                 MockItem[]
}

model SessionAttendance {
  id                    String        @id @default(cuid())
  sessionId             String
  session               AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  serviceId             String?
  service               Service?      @relation(fields: [serviceId], references: [id])
  studentId             String
  student               User          @relation(fields: [studentId], references: [id])
  enrolmentItemId       String?
  enrolmentItem         StudentEnrolmentItem? @relation(fields: [enrolmentItemId], references: [id], onDelete: Cascade)
  status                String        @default("PRESENT") // "PRESENT" | "ABSENT_NO_SHOW" etc.
  teacherLoggedHours    Float?
  studentLoggedHours    Float?
  hoursMatch            Boolean       @default(true)
  hoursMatchStatus      String        @default("MATCHED")
  noShowCount           Int           @default(0)
  changeRequestPending  Boolean       @default(false)
  changeRequestStatus   String?
  feedbackStars         Int?
  feedbackText          String?
  feedbackGivenAt       DateTime?
  notes                 String?
  markedAt              DateTime?

  @@unique([sessionId, studentId])
}

// ─── CLUSTER 12 — STAFF MEETINGS ────────────────────────────────────────────

model Meeting {
  id                    String                @id @default(cuid())
  staffServiceId        String?
  staffServiceScheduleId String?
  occurrenceId          String?
  scheduledByUserId     String?
  sessionTypeId         String?
  sessionType           SessionType?          @relation(fields: [sessionTypeId], references: [id])
  title                 String
  agenda                String?
  startTime             DateTime
  endTime               DateTime
  originalStartTime     DateTime?
  originalEndTime       DateTime?
  durationHours         Float
  isTrial               Boolean               @default(false)
  status                String                @default("scheduled")
  sessionMode           String                @default("SCHEDULED")
  zoomLink              String?
  zoomId                String?
  zoomPasscode          String?
  addedToCalendar       Boolean               @default(false)
  calendarSyncedAt      DateTime?
  recordingUrl          String?
  transcriptUrl         String?
  summaryUrl            String?
  dept                  String?
  isActive              Boolean               @default(true)

  attendances           MeetingAttendance[]
}

model MeetingParticipant {
  id               String          @id @default(cuid())
  generalMeetingId String
  generalMeeting   GeneralMeeting  @relation("GeneralMeetingParticipants", fields: [generalMeetingId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  rsvp             String          @default("pending") // "accepted" | "declined" | "pending"

  @@unique([generalMeetingId, userId])
}

model MeetingAttendance {
  id                    String              @id @default(cuid())
  meetingId             String
  meeting               Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  staffServiceId        String
  staffId               String
  enrolmentItemId       String
  enrolmentItem         StaffEnrolmentItem  @relation(fields: [enrolmentItemId], references: [id], onDelete: Cascade)
  status                String
  staffLoggedHours      Float
  managementLoggedHours Float
  hoursMatch            Boolean             @default(true)
  hoursMatchStatus      String?
  noShowCount           Int                 @default(0)
  changeRequestPending  Boolean             @default(false)
  changeRequestStatus   String?
  feedbackStars         Int?
  feedbackText          String?
  feedbackGivenAt       DateTime?
  notes                 String?
  markedAt              DateTime?
}

// ─── CLUSTER 13 — AMBASSADOR MEETINGS ───────────────────────────────────────

model AmbassadorMeeting {
  id                    String                @id @default(cuid())
  ambassadorServiceId   String?
  scheduleId            String?
  occurrenceId          String?
  scheduledByUserId     String?
  sessionTypeId         String?
  sessionType           SessionType?          @relation(fields: [sessionTypeId], references: [id])
  title                 String
  agenda                String?
  startTime             DateTime
  endTime               DateTime
  originalStartTime     DateTime?
  originalEndTime       DateTime?
  durationHours         Float
  isTrial               Boolean               @default(false)
  status                String                @default("scheduled")
  sessionMode           String                @default("SCHEDULED")
  zoomLink              String?
  zoomId                String?
  zoomPasscode          String?
  addedToCalendar       Boolean               @default(false)
  calendarSyncedAt      DateTime?
  recordingUrl          String?
  transcriptUrl         String?
  summaryUrl            String?
  isActive              Boolean               @default(true)

  attendances           AmbassadorMeetingAttendance[]
}

model AmbassadorMeetingAttendance {
  id                    String              @id @default(cuid())
  meetingId             String
  meeting               AmbassadorMeeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  ambassadorId          String
  enrolmentItemId       String
  enrolmentItem         AmbassadorEnrolmentItem @relation(fields: [enrolmentItemId], references: [id], onDelete: Cascade)
  status                String
  ambassadorLoggedHours Float
  managementLoggedHours Float
  hoursMatch            Boolean             @default(true)
  hoursMatchStatus      String?
  noShowCount           Int                 @default(0)
  changeRequestPending  Boolean             @default(false)
  changeRequestStatus   String?
  feedbackStars         Int?
  feedbackText          String?
  feedbackGivenAt       DateTime?
  notes                 String?
  markedAt              DateTime?
}

// ─── CLUSTER 14 — CALENDAR SYSTEM ───────────────────────────────────────────

model CalendarItem {
  id                String    @id @default(cuid())
  entityType        String    // "ACADEMIC_SESSION" | "MEETING" | "AMBASSADOR_MEETING"
  entityId          String
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  startTime         DateTime
  endTime           DateTime
  title             String
  colour            String?
  status            String
  addedToGCal       Boolean   @default(false)
  gCalSyncedAt      DateTime?
  gCalEventId       String?
}

// ─── CLUSTER 15 — CURRICULUM (STUDENT) ──────────────────────────────────────

model CurriculumList {
  id              String      @id @default(cuid())
  serviceId       String      @unique
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isActive        Boolean     @default(true)

  syllabusLists   SyllabusList[]
  taskLists       TaskList[]
  mockLists       MockList[]
  timelineLists   CourseTimelineList[]
}

model SyllabusList {
  id                 String               @id @default(cuid())
  curriculumListId   String
  curriculumList     CurriculumList       @relation(fields: [curriculumListId], references: [id], onDelete: Cascade)
  name               String
  version            String
  level              String
  status             String               @default("ACTIVE")
  activatedAt        DateTime             @default(now())
  pausedAt           DateTime?
  deactivatedAt      DateTime?
  isActive           Boolean              @default(true)

  syllabusItems      SyllabusItem[]
  history            SyllabusListStatusHistory[]
}

model SyllabusListStatusHistory {
  id              String        @id @default(cuid())
  syllabusListId  String
  syllabusList    SyllabusList  @relation(fields: [syllabusListId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime      @default(now())
  changedByUserId String
  reason          String?
}

model SyllabusItem {
  id                 String               @id @default(cuid())
  syllabusListId     String
  syllabusList       SyllabusList         @relation(fields: [syllabusListId], references: [id], onDelete: Cascade)
  subject            String?
  chapterNum         String
  chapterTitle       String
  topicCode          String?
  topicTitle         String
  level              String
  order              Int
  lectureCompleted   Boolean              @default(false)
  pastPaperQCount    Int                  @default(0)
  marksLostInPPQ     Float                @default(0)
  pastPaperNotesLink String?
  difficultTopics    String?
  note               String?
  isActive           Boolean              @default(true)

  progressList       StudentProgress[]
  doubts             Doubt[]
  taskItems          TaskItem[]
  mockItems          MockItem[]
  courseTimelineItems CourseTimelineItem[]
}

model StudentProgress {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation(fields: [studentId], references: [id])
  syllabusItemId  String
  syllabusItem    SyllabusItem  @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  status          String        @default("IN_PROGRESS")
  masteryPct      Int           @default(0)
  completed       Boolean       @default(false)
  updatedAt       DateTime      @updatedAt

  @@unique([studentId, syllabusItemId])
}

model TaskType {
  id              String      @id @default(cuid())
  name            String      @unique
  isActive        Boolean     @default(true)

  taskItems       TaskItem[]
}

model TaskList {
  id              String      @id @default(cuid())
  curriculumListId String
  curriculumList  CurriculumList @relation(fields: [curriculumListId], references: [id], onDelete: Cascade)
  isActive        Boolean     @default(true)

  taskItems       TaskItem[]
}

model TaskItem {
  id              String        @id @default(cuid())
  taskListId      String
  taskList        TaskList      @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  taskTypeId      String
  taskType        TaskType      @relation(fields: [taskTypeId], references: [id])
  sessionId       String?
  session         AcademicSession? @relation(fields: [sessionId], references: [id])
  syllabusItemId  String?
  syllabusItem    SyllabusItem? @relation(fields: [syllabusItemId], references: [id])
  serviceId       String?
  service         Service?      @relation(fields: [serviceId], references: [id])
  title           String
  description     String?
  hwLink          String?
  paperLink       String?
  dueDate         DateTime
  assignedToAll   Boolean       @default(false)
  isActive        Boolean       @default(true)

  assignments     TaskAssignment[]
  submissions     TaskSubmission[]
  timelineItems   CourseTimelineItem[]
}

model TaskAssignment {
  id              String    @id @default(cuid())
  taskItemId      String
  taskItem        TaskItem  @relation(fields: [taskItemId], references: [id], onDelete: Cascade)
  studentId       String
  student         User      @relation(fields: [studentId], references: [id])

  @@unique([taskItemId, studentId])
}

model TaskSubmission {
  id              String    @id @default(cuid())
  taskItemId      String
  taskItem        TaskItem  @relation(fields: [taskItemId], references: [id], onDelete: Cascade)
  studentId       String
  student         User      @relation(fields: [studentId], references: [id])
  status          String
  totalMarks      Float
  marksScored     Float
  marksLost       Float
  subtopicsLostOn String?
  submissionLink  String?
  notes           String?
  submittedAt     DateTime  @default(now())

  @@unique([taskItemId, studentId])
}

model MockList {
  id              String      @id @default(cuid())
  curriculumListId String
  curriculumList  CurriculumList @relation(fields: [curriculumListId], references: [id], onDelete: Cascade)
  isActive        Boolean     @default(true)

  mockItems       MockItem[]
}

model MockItem {
  id              String        @id @default(cuid())
  mockListId      String
  mockList        MockList      @relation(fields: [mockListId], references: [id], onDelete: Cascade)
  sessionId       String?
  session         AcademicSession? @relation(fields: [sessionId], references: [id])
  syllabusItemId  String?
  syllabusItem    SyllabusItem? @relation(fields: [syllabusItemId], references: [id])
  serviceId       String?
  service         Service?      @relation(fields: [serviceId], references: [id])
  mockType        String
  paperCode       String?
  paperLink       String?
  scheduledDate   DateTime
  totalMarks      Float
  isActive        Boolean       @default(true)

  results         MockResult[]
  timelineItems   CourseTimelineItem[]
}

model MockResult {
  id              String    @id @default(cuid())
  mockItemId      String?
  mockItem        MockItem? @relation(fields: [mockItemId], references: [id], onDelete: Cascade)
  studentId       String
  student         User      @relation(fields: [studentId], references: [id])
  marksScored     Float?
  marksAvailable  Float?
  marksLost       Float?
  submissionLink  String?
  correctionLink  String?
  notes           String?
  completed       Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  serviceId       String?
  service         Service?  @relation(fields: [serviceId], references: [id])
  subject         String?
  level           String?
  diff            String?
  score           Float?
  grade           String?
  timeTaken       Int?

  @@unique([mockItemId, studentId])
  @@index([studentId])
  @@index([serviceId])
}

model CourseTimelineList {
  id              String      @id @default(cuid())
  curriculumListId String
  curriculumList  CurriculumList @relation(fields: [curriculumListId], references: [id], onDelete: Cascade)
  isActive        Boolean     @default(true)

  items           CourseTimelineItem[]
}

model CourseTimelineItem {
  id              String              @id @default(cuid())
  timelineListId  String
  timelineList    CourseTimelineList  @relation(fields: [timelineListId], references: [id], onDelete: Cascade)
  month           String
  weekNumber      Int
  itemType        String
  syllabusItemId  String?
  syllabusItem    SyllabusItem?       @relation(fields: [syllabusItemId], references: [id])
  taskItemId      String?
  taskItem        TaskItem?           @relation(fields: [taskItemId], references: [id])
  mockItemId      String?
  mockItem        MockItem?           @relation(fields: [mockItemId], references: [id])
  notes           String?
}

// ─── CLUSTER 15B — CURRICULUM (AMBASSADOR) ──────────────────────────────────

model AmbassadorProgrammeList {
  id                  String      @id @default(cuid())
  ambassadorServiceId String      @unique
  isActive            Boolean     @default(true)

  programmes          AmbassadorProgramme[]
  testLists           AmbassadorTestList[]
  timelineLists       AmbassadorProgrammeTimelineList[]
}

model AmbassadorProgramme {
  id                  String    @id @default(cuid())
  programmeListId     String
  programmeList       AmbassadorProgrammeList @relation(fields: [programmeListId], references: [id], onDelete: Cascade)
  name                String
  version             String
  status              String
  activatedAt         DateTime  @default(now())
  pausedAt            DateTime?
  deactivatedAt       DateTime?
  isActive            Boolean   @default(true)

  items               AmbassadorProgrammeItem[]
  history             AmbassadorProgrammeListStatusHistory[]
}

model AmbassadorProgrammeListStatusHistory {
  id              String              @id @default(cuid())
  programmeListId String
  programmeList   AmbassadorProgramme @relation(fields: [programmeListId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime            @default(now())
  changedByUserId String
  reason          String?
}

model AmbassadorProgrammeItem {
  id              String    @id @default(cuid())
  programmeId     String
  programme       AmbassadorProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  programmeCode   String
  programmeTitle  String
  level           String
  order           Int
  note            String?
  isActive        Boolean   @default(true)

  progressList    AmbassadorProgrammeProgress[]
  testItems       AmbassadorTestItem[]
  timelineItems   AmbassadorProgrammeTimelineItem[]
}

model AmbassadorProgrammeProgress {
  id              String                  @id @default(cuid())
  ambassadorId    String
  ambassador      User                    @relation(fields: [ambassadorId], references: [id])
  programmeItemId String
  programmeItem   AmbassadorProgrammeItem @relation(fields: [programmeItemId], references: [id], onDelete: Cascade)
  status          String
  masteryPct      Int
  updatedAt       DateTime                @updatedAt

  @@unique([ambassadorId, programmeItemId])
}

model AmbassadorTestList {
  id                  String      @id @default(cuid())
  programmeListId     String
  programmeList       AmbassadorProgrammeList @relation(fields: [programmeListId], references: [id], onDelete: Cascade)
  isActive            Boolean     @default(true)

  testItems           AmbassadorTestItem[]
}

model AmbassadorTestItem {
  id                  String                  @id @default(cuid())
  testListId          String
  testList            AmbassadorTestList      @relation(fields: [testListId], references: [id], onDelete: Cascade)
  meetingId           String?
  programmeItemId     String?
  programmeItem       AmbassadorProgrammeItem? @relation(fields: [programmeItemId], references: [id])
  testType            String
  paperLink           String?
  scheduledDate       DateTime
  totalMarks          Float
  isActive            Boolean                 @default(true)

  results             AmbassadorTestResult[]
  timelineItems       AmbassadorProgrammeTimelineItem[]
}

model AmbassadorTestResult {
  id              String              @id @default(cuid())
  testItemId      String
  testItem        AmbassadorTestItem  @relation(fields: [testItemId], references: [id], onDelete: Cascade)
  ambassadorId    String
  ambassador      User                @relation(fields: [ambassadorId], references: [id])
  marksScored     Float
  marksAvailable  Float
  marksLost       Float
  submissionLink  String?
  notes           String?
  completed       Boolean             @default(false)
  completedAt     DateTime?

  @@unique([testItemId, ambassadorId])
}

model AmbassadorProgrammeTimelineList {
  id              String                  @id @default(cuid())
  programmeListId String
  programmeList   AmbassadorProgrammeList @relation(fields: [programmeListId], references: [id], onDelete: Cascade)
  isActive        Boolean                 @default(true)

  items           AmbassadorProgrammeTimelineItem[]
}

model AmbassadorProgrammeTimelineItem {
  id              String                          @id @default(cuid())
  timelineListId  String
  timelineList    AmbassadorProgrammeTimelineList @relation(fields: [timelineListId], references: [id], onDelete: Cascade)
  month           String
  weekNumber      Int
  itemType        String
  programmeItemId String?
  programmeItem   AmbassadorProgrammeItem?        @relation(fields: [programmeItemId], references: [id])
  taskItemId      String?
  testItemId      String?
  testItem        AmbassadorTestItem?             @relation(fields: [testItemId], references: [id])
  notes           String?
}

// ─── CLUSTER 16 — REFERRALS ─────────────────────────────────────────────────

model Referral {
  id                String              @id @default(cuid())
  referrerId        String
  referrer          User                @relation("Referrer", fields: [referrerId], references: [id])
  referredStudentId String?
  code              String
  status            String              @default("pending") // "pending"|"enrolled"|"expired"
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())

  earnings          AmbassadorEarning[]
  clicks            ReferralClick[]

  @@index([referrerId])
}

model ReferralClick {
  id                    String    @id @default(cuid())
  referralId            String
  referral              Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  ipAddress             String?
  userAgent             String?
  clickedAt             DateTime  @default(now())
  convertedToEnquiry    Boolean   @default(false)
  convertedToEnrolment  Boolean   @default(false)
}

// ─── CLUSTER 17 — STUDENT INVOICING ─────────────────────────────────────────

model InvoiceMonth {
  id        String           @id @default(cuid())
  month     String           @unique // "Aug_of_2022"
  serialNo  Int?             // XLSX serial

  invoices  StudentInvoice[]
  claims    Claim[]
  paychecks Paycheck[]
  ambassadorPaychecks AmbassadorPaycheck[]
}

model StudentInvoice {
  id                        String            @id @default(cuid())
  studentId                 String
  student                   User              @relation(fields: [studentId], references: [id])
  invoiceMonthId            String?
  invoiceMonth              InvoiceMonth?     @relation(fields: [invoiceMonthId], references: [id])
  receivingPaymentMethodId String?
  receivingPaymentMethod   PaymentMethod?    @relation(fields: [receivingPaymentMethodId], references: [id])
  month                     String            // "YYYY-MM"
  invoiceMode               String?           // "Tuition" etc.
  subtotal                  Float             @default(0)
  discountApplied           Float             @default(0)
  netAmount                 Float             @default(0)
  dueAmount                 Float             @default(0)
  currency                  String
  paymentDone               Boolean           @default(false)
  paymentDate               DateTime?
  paymentMethod             String?
  referenceNo               String?
  reminderStage             Int               @default(0)
  invoicePdfUrl             String?
  paymentAcknowledgementMsg String?
  paymentReminderMsg        String?
  serialNo                  Int?
  status                    String            @default("draft") // "draft"|"paid"|"overdue"
  isActive                  Boolean           @default(true)
  issuedAt                  DateTime?
  billingStart              DateTime?
  billingEnd                DateTime?
  createdAt                 DateTime          @default(now())
  totalAmount               Float?

  lineItems                 InvoiceLineItem[]
  ledgerEntries             LedgerEntry[]
  history                   StudentInvoiceStatusChangeLog[]

  @@index([studentId])
}

model StudentInvoiceStatusChangeLog {
  id              String          @id @default(cuid())
  invoiceId       String
  invoice         StudentInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime        @default(now())
  changedByUserId String
  reason          String?
}

model InvoiceLineItem {
  id                    String        @id @default(cuid())
  invoiceId             String
  invoice               StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineType              String?       // "batch_tuition" | "book" etc.
  enrolmentItemId       String?
  enrolmentItem         StudentEnrolmentItem? @relation(fields: [enrolmentItemId], references: [id])
  sessionId             String?
  sessionDate           DateTime?
  sessionStart          DateTime?
  sessionEnd            DateTime?
  originalSessionStart  DateTime?
  originalSessionEnd    DateTime?
  attendanceStatusSnapshot String?
  isTrialSession        Boolean       @default(false)
  sessionHours          Float?
  rateSnapshot          Float?
  groupCodeSnapshot     String?
  teacherNameSnapshot   String?
  serviceNameSnapshot   String?
  currency              String?
  hoursOrQty            Float?
  lineTotal             Float?
  originalInvoiceId     String?
  originalLineItemId    String?
  correctionReason      String?
  originalSessionDate   DateTime?
  correctionAmount      Float?
  description           String?
  originalAmount        Float?
  originalCurrency      String?
  conversionRateUsed    Float?
  convertedAmount       Float?

  @@index([invoiceId])
}

// ─── CLUSTER 18 — CLAIMS & COMPENSATION ─────────────────────────────────────

model Claim {
  id                        String        @id @default(cuid())
  userId                    String
  user                      User          @relation(fields: [userId], references: [id])
  enrolmentListId           String?
  claimantType              String?       // "teacher" | "staff"
  month                     String        // "Apr_of_2026"
  dept                      String        // Drives budget debits
  sessions                  Int?
  hours                     Float?
  rateApplied               Float?
  amount                    Float
  currency                  String        @default("INR")
  receivingPaymentMethodId String?
  status                    String        @default("pending") // "pending"|"approved"|"paid"
  notes                     String?
  notes2                    String?
  startDate                 DateTime?
  endDate                   DateTime?
  paymentDate               DateTime?
  isActive                  Boolean       @default(true)
  createdAt                 DateTime      @default(now())
  invoiceMonthId            String?
  invoiceMonth              InvoiceMonth? @relation(fields: [invoiceMonthId], references: [id])

  ledgerEntries             LedgerEntry[]
  utilisations              BudgetUtilisation[]
  history                   ClaimStatusChangeLog[]
  paychecks                 Paycheck[]

  @@index([userId])
}

model ClaimLineItem {
  id                    String        @id @default(cuid())
  claimId               String
  serviceId             String?
  service               Service?      @relation(fields: [serviceId], references: [id])
  sessionId             String?
  sessionDate           DateTime?
  sessionStart          DateTime?
  sessionEnd            DateTime?
  sessionHours          Float?
  staffRateSnapshot     Float?
  lineTotal             Float
  currency              String
  serviceNameSnapshot   String?
  groupCodeSnapshot     String?
}

model ClaimStatusChangeLog {
  id              String    @id @default(cuid())
  claimId         String
  claim           Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedAt       DateTime  @default(now())
  changedByUserId String
