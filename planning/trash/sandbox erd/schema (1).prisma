// =============================================================================
// DivergenCIE — Sandbox Prisma Schema v3.0
// Ground Truth: DC Database 2026.xlsx + UJM v3.0
// Decisions: Q1–Q21 locked. See ERD v2.0 for full decision log.
// Engine: SQLite (dev) / PostgreSQL (prod) — syntax compatible with both
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/sandbox"
}

datasource db {
  provider = "sqlite"
}

// =============================================================================
// CLUSTER 1 — USERS & PROFILES
// =============================================================================

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  role                String    // "management"|"staff"|"teacher"|"student"|"parent"|"ambassador"
  dept                String?   // "PR"|"HR"|"Finance"|"Marketing"|"IT"|"Management"
  supervisor          Boolean   @default(false)
  financeApprovedFlag Boolean   @default(false)
  isActive            Boolean   @default(true)
  passwordHash        String?
  referralCode        String?   @unique
  detectedCountry     String?
  billingAddress      String?
  createdAt           DateTime  @default(now())

  // Parent–student self-join
  parentId            String?
  parent              User?     @relation("ParentStudent", fields: [parentId], references: [id])
  children            User[]    @relation("ParentStudent")

  // Profile relations (one per role, all optional)
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  staffProfile        StaffProfile?
  parentProfile       ParentProfile?
  ambassadorProfile   AmbassadorProfile?

  // Bank accounts this user volunteers for DC use
  bankAccounts        BankAccount[]

  // Service: teacher assignment
  services            Service[]

  // Enrollment: student cart
  enrollments         Enrollment[]

  // Academic
  taughtSessions      AcademicSession[]   @relation("TeacherSessions")
  attendances         Attendance[]
  assignments         Assignment[]
  mockResults         MockResult[]
  doubts              Doubt[]
  studentProgress     StudentProgress[]

  // Finance
  invoices            StudentInvoice[]
  claims              Claim[]

  // Referrals
  referralsGiven      Referral[]          @relation("Referrer")

  // Tickets
  ticketsCreated      Ticket[]            @relation("TicketCreator")
  ticketsAssigned     Ticket[]            @relation("TicketAssignee")
  ticketMessages      TicketMessage[]
  ticketHistory       TicketHistory[]

  // Meetings
  meetingParticipants MeetingParticipant[]

  // Ambassador
  contentBankItems    ContentBankItem[]

  @@index([role])
  @@index([dept])
  @@index([isActive])
}

model StudentProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  dob                   DateTime?
  grade                 String?   // "IGCSE"|"AS-Level"|"A-Level"
  board                 String?   // "Cambridge"|"Edexcel"|"IB"|"AQA"
  targetUni             String?
  school                String?   // XLSX: School
  currency              String?   // preferred billing currency
  timeZone              String?   // XLSX: Time Zone
  timesheetUrl          String?   // XLSX: Timesheet
  gcrLink               String?   // XLSX: GCR
  scheduleLink          String?   // XLSX: Schedule
  progressTrackerLink   String?   // XLSX: Progress Tracker
  whatsappNumber        String?   // XLSX: WhatsApp Number
  parentWhatsappNumber  String?   // XLSX: Parent WhatsApp Number
  location              String?   // XLSX: Location
  notes                 String?   // XLSX: Notes — free-text blob
  referredBy            String?   // dedicated referral source field (Q4)
  createdAt             DateTime  @default(now())
}

model TeacherProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  dob                   DateTime?
  latestQualification   String?
  teachingProfileUrl    String?
  // No subjects on teacher profile — mapping is at Service level (Q8/UJM)
  createdAt             DateTime  @default(now())
}

model StaffProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  dob                   DateTime?
  roleTitle             String?   // "Associate Project Manager"|"Teaching Assistant" etc.
  salaryType            String?   // "fixed"|"hourly"
  salaryRate            Float?
  latestQualification   String?
  // No bankAccountInfo string — use BankAccount table (Q8)
  createdAt             DateTime  @default(now())
}

model ParentProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  phone       String?
  address     String?
  createdAt   DateTime  @default(now())
}

model AmbassadorProfile {
  id              String                  @id @default(cuid())
  userId          String                  @unique
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  dob             DateTime?
  cohort          String?                 // "3mo"|"6mo"
  referralLink    String?
  referralCode    String?                 @unique
  // No bankAccountInfo string — use BankAccount table (Q8)
  deliverables    AmbassadorDeliverable[]
  earnings        AmbassadorEarning[]
  createdAt       DateTime                @default(now())
}

// Normalized bank accounts — replaces DCBankAccount + bankAccountInfo strings (Q8)
// isDcAccount=true: DC uses this account operationally (e.g. Atiqa, Akhtar)
// These are real accounts owned by volunteer staff, strictly separate from their claims
model BankAccount {
  id              String          @id @default(cuid())
  ownerId         String          // User.id of account holder
  owner           User            @relation(fields: [ownerId], references: [id])
  isDcAccount     Boolean         @default(false) // true = DC operational account
  label           String          // "Atiqa Akhtar Account"|"Expansion Account" etc.
  purpose         String?         // "operations"|"savings"|"expansion"|"backup"
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  branchName      String?
  paytmId         String?
  currency        String
  currentBalance  Float           @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  // Budget and ledger relations
  deptBudgets     DeptBudget[]
  ledgerEntries   LedgerEntry[]
  transactions    AccountTransaction[]

  @@index([ownerId])
  @@index([isDcAccount])
}

// =============================================================================
// CLUSTER 2 — SERVICE CATALOGUE & GROUPS
// =============================================================================

// Group: the delivery vehicle (B8, C14, T3)
// Teacher is assigned at Service level, not Group level (Q2)
model Group {
  id            String            @id @default(cuid())
  code          String            @unique // "B8"|"C14"|"T3" etc.
  groupCategory String            // "batch"|"individual"|"ondemand"
  status        String            @default("active") // "active"|"inactive"|"completed"
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())

  services      Service[]
  sessions      AcademicSession[]
}

// Service: atomic hub — the single source of truth for what is taught, by whom, at what rate (Q2)
// groupId null = catalogue default / ad-hoc service (Q9)
model Service {
  id                    String            @id @default(cuid())
  groupId               String?           // null for ad-hoc/catalogue defaults
  group                 Group?            @relation(fields: [groupId], references: [id])
  teacherId             String
  teacher               User              @relation(fields: [teacherId], references: [id])
  board                 String?           // "Cambridge"|"Edexcel"|"IB"|"OCR"|"AQA"|"CollegeBoard"|"IDP"|"KSA"|"DC"|"Singapore"|"IMAT"
  courseLevel           String?           // "IGCSE"|"AS-Level"|"A-Level"|"GCSE"|"DP"|"SAT"|"IELTS"|"GAT"|"ACT"|"BTech"
  subjectCode           String?           // "0580"|"9701"|"J277" etc. — null for ad-hoc
  subjectName           String            // "Mathematics"|"Chemistry"|"Counselling" etc.
  fullSubjectName       String?           // "Cambridge A-Level Chemistry - B8 - GBP" — generated label
  serviceType           String            // "batch_tuition"|"individual_tuition"|"ondemand_tuition"|"book"|"counselling"|"adhoc"
  currency              String
  standardRate          Float
  isHourly              Boolean           @default(false)
  instructorNameSnapshot String?          // teacher name at creation — historical safety (Q5)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())

  enrollments           Enrollment[]
  sessions              AcademicSession[]
  syllabusItems         SyllabusItem[]
  assignments           Assignment[]
  mockResults           MockResult[]

  @@index([groupId])
  @@index([teacherId])
  @@index([serviceType])
  @@index([currency])
}

// =============================================================================
// CLUSTER 3 — ENROLLMENT (THE CART)
// =============================================================================

// Enrollment unit is (student, service) — group is derivable via service (Q10)
// status="one_time" for ad-hoc shadow enrollments (Q21/invoice decision)
model Enrollment {
  id              String            @id @default(cuid())
  studentId       String
  student         User              @relation(fields: [studentId], references: [id])
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  status          String            @default("active") // "active"|"paused"|"cancelled"|"completed"|"trial"|"one_time"
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())

  discounts       Discount[]
  invoiceItems    InvoiceLineItem[]

  @@unique([studentId, serviceId])
  @@index([studentId])
  @@index([serviceId])
  @@index([status])
}

// Discount table — per student, optionally per service (Q6c)
// serviceId null = invoice-level discount applied to all line items
model Discount {
  id              String      @id @default(cuid())
  studentId       String
  enrollmentId    String?
  enrollment      Enrollment? @relation(fields: [enrollmentId], references: [id])
  discountType    String      // "scholarship"|"coupon"|"manual"
  value           Float       // amount or percentage
  isPct           Boolean     @default(true)
  code            String?     // coupon code if applicable
  validFrom       DateTime?
  validTo         DateTime?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  @@index([studentId])
  @@index([enrollmentId])
}

// =============================================================================
// CLUSTER 4 — ACADEMIC SESSIONS & ATTENDANCE
// =============================================================================

// Session is group-level — one session, many students attend (Q11)
// One service per session (Q from ERD open questions — answered: one service)
model AcademicSession {
  id                        String       @id @default(cuid())
  groupId                   String
  group                     Group        @relation(fields: [groupId], references: [id])
  teacherId                 String
  teacher                   User         @relation("TeacherSessions", fields: [teacherId], references: [id])
  serviceId                 String       // which subject this session covers
  service                   Service      @relation(fields: [serviceId], references: [id])
  topic                     String?
  startTime                 DateTime
  endTime                   DateTime
  durationMinutes           Int?
  zoomLink                  String?
  wbLink                    String?      // whiteboard link
  wbName                    String?      // whiteboard name — teacher submission field
  recordingLink             String?
  status                    String       @default("scheduled") // "scheduled"|"completed"|"missed"|"cancelled"|"rescheduled"
  timesheetSubmissionStatus String       @default("pending")   // "pending"|"submitted"|"overdue"
  timesheetSubmittedAt      DateTime?
  isActive                  Boolean      @default(true)
  createdAt                 DateTime     @default(now())

  attendances               Attendance[]

  @@index([groupId])
  @@index([teacherId])
  @@index([serviceId])
  @@index([startTime])
  @@index([status])
}

// Attendance is per-student join table (Q11)
model Attendance {
  id              String          @id @default(cuid())
  sessionId       String
  session         AcademicSession @relation(fields: [sessionId], references: [id])
  studentId       String
  student         User            @relation(fields: [studentId], references: [id])
  status          String          @default("present") // "present"|"absent"|"late"|"missed"
  durationMinutes Int?
  notes           String?
  markedAt        DateTime        @default(now())

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

// =============================================================================
// CLUSTER 5 — BILLING & INVOICING
// =============================================================================

model InvoiceMonth {
  id        String           @id @default(cuid())
  serialNo  Int?             // XLSX: S. No.
  month     String           @unique // XLSX: Month e.g. "Aug_of_2022"
  invoices  StudentInvoice[]
}

// All incoming revenue (tuition, books, counselling) → Management BankAccount
// via LedgerEntry on payment. Outside dept budget system (Q17).
model StudentInvoice {
  id                        String            @id @default(cuid())
  studentId                 String
  student                   User              @relation(fields: [studentId], references: [id])
  invoiceMonthId            String?
  invoiceMonth              InvoiceMonth?     @relation(fields: [invoiceMonthId], references: [id])
  month                     String            // "YYYY-MM" snapshot
  billingStart              DateTime?
  billingEnd                DateTime?
  totalAmount               Float             @default(0)
  discountApplied           Float             @default(0)
  netAmount                 Float             @default(0)
  dueAmount                 Float             @default(0)
  currency                  String
  paymentDone               Boolean           @default(false)
  paymentDate               DateTime?
  paymentMethod             String?
  referenceNo               String?
  reminderStage             Int               @default(0) // 1–5 per UJM Finance journey
  invoicePdfUrl             String?
  paymentAcknowledgementMsg String?           // XLSX: auto-generated acknowledgement msg
  paymentReminderMsg        String?           // XLSX: WhatsApp deeplink reminder msg
  serialNo                  Int?              // XLSX: S. No.
  status                    String            @default("draft") // "draft"|"issued"|"paid"|"overdue"|"deactivated"
  isActive                  Boolean           @default(true)
  issuedAt                  DateTime?
  createdAt                 DateTime          @default(now())

  lineItems                 InvoiceLineItem[]
  ledgerEntries             LedgerEntry[]

  @@index([studentId])
  @@index([month])
  @@index([status])
}

// Single line item table — serviceType enum drives which fields are populated (Q6a)
// enrollmentId null only for one_time shadow enrollments which are created first (Q21)
model InvoiceLineItem {
  id                    String      @id @default(cuid())
  invoiceId             String
  invoice               StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  enrollmentId          String?
  enrollment            Enrollment? @relation(fields: [enrollmentId], references: [id])
  serviceType           String      // "batch_tuition"|"individual_tuition"|"ondemand_tuition"|"book"|"counselling"|"adhoc"
  // Snapshot fields — cloned at generation time, frozen forever (Q6b)
  serviceNameSnapshot   String?     // "Physics - CIE A-Level - B8"
  teacherNameSnapshot   String?     // "Mr Akhtar"
  groupCodeSnapshot     String?     // "B8"
  rateSnapshot          Float?      // rate at generation time
  currency              String
  isHourly              Boolean     @default(false)
  hoursOrQty            Float?      // hours if isHourly; quantity if book
  unitPrice             Float?      // for books
  lineTotal             Float
  notes                 String?

  @@index([invoiceId])
  @@index([enrollmentId])
}

// =============================================================================
// CLUSTER 6 — CLAIMS & COMPENSATION
// =============================================================================

// dept field determines which DeptBudget.claims sub-category is auto-debited (Q16)
model Claim {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  dept          String        // claimant dept — drives budget debit routing
  month         String        // "Apr_of_2026"
  sessions      Int?
  hours         Float?
  rateApplied   Float?
  amount        Float
  currency      String        @default("INR")
  status        String        @default("pending") // "pending"|"approved"|"rejected"|"paid"
  notes         String?
  notes2        String?       // XLSX: Notes 2
  startDate     DateTime?     // XLSX: Started
  endDate       DateTime?     // XLSX: Finish
  paymentDate   DateTime?     // XLSX: Date done
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  ledgerEntries LedgerEntry[]
  utilisations  BudgetUtilisation[]

  @@index([userId])
  @@index([dept])
  @@index([status])
}

// =============================================================================
// CLUSTER 7 — ACCOUNTS, BUDGETS & LEDGER
// =============================================================================

// Raw transaction record on a BankAccount
model AccountTransaction {
  id              String        @id @default(cuid())
  bankAccountId   String
  bankAccount     BankAccount   @relation(fields: [bankAccountId], references: [id])
  description     String
  transactionType String        // "credit"|"debit"
  amount          Float
  currency        String
  createdAt       DateTime      @default(now())

  ledgerEntries   LedgerEntry[]

  @@index([bankAccountId])
}

// Double-entry ledger — one entry per side of a transaction
model LedgerEntry {
  id              String              @id @default(cuid())
  transactionId   String
  transaction     AccountTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  bankAccountId   String
  bankAccount     BankAccount         @relation(fields: [bankAccountId], references: [id])
  amount          Float
  direction       String              // "debit"|"credit"
  purpose         String              // "revenue"|"claim_payment"|"operations_payment"|"budget_allocation"
  // Reference fields — one populated depending on purpose
  studentInvoiceId String?
  studentInvoice   StudentInvoice?    @relation(fields: [studentInvoiceId], references: [id])
  claimId         String?
  claim           Claim?              @relation(fields: [claimId], references: [id])
  createdAt       DateTime            @default(now())

  utilisations    BudgetUtilisation[]

  @@index([bankAccountId])
  @@index([studentInvoiceId])
  @@index([claimId])
}

// Quarterly dept budget — auto-created at quarter start with totalAllocated=0 (Q14)
// Previous quarters locked as read-only (status="closed")
model DeptBudget {
  id                String              @id @default(cuid())
  dept              String              // "PR"|"HR"|"Finance"|"Marketing"|"IT"|"Management"
  quarter           String              // "2026-Q1"|"2026-Q2" etc.
  totalAllocated    Float               @default(0)
  status            String              @default("draft") // "draft"|"approved"|"active"|"closed"
  bankAccountId     String              // account this budget draws from
  bankAccount       BankAccount         @relation(fields: [bankAccountId], references: [id])
  approvedByUserId  String?             // Management user who approved
  approvedAt        DateTime?
  quarterStart      DateTime
  quarterEnd        DateTime
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())

  subCategories     BudgetSubCategory[]

  @@unique([dept, quarter])
  @@index([dept])
  @@index([status])
}

// Exactly 2 per DeptBudget — "claims" and "operations" (Q16)
// claims: auto-debited by Claim approvals
// operations: auto-debited by everything else
model BudgetSubCategory {
  id              String              @id @default(cuid())
  budgetId        String
  budget          DeptBudget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  subCategoryType String              // "claims"|"operations"
  allocated       Float               @default(0) // portion of parent totalAllocated
  utilised        Float               @default(0) // auto-updated on each BudgetUtilisation
  remaining       Float               @default(0) // allocated - utilised
  createdAt       DateTime            @default(now())

  utilisations    BudgetUtilisation[]

  @@unique([budgetId, subCategoryType])
}

// Created automatically whenever a payment hits a budget sub-category (Q15)
model BudgetUtilisation {
  id              String              @id @default(cuid())
  subCategoryId   String
  subCategory     BudgetSubCategory   @relation(fields: [subCategoryId], references: [id])
  ledgerEntryId   String
  ledgerEntry     LedgerEntry         @relation(fields: [ledgerEntryId], references: [id])
  referenceType   String              // "claim"|"invoice"|"ad_hoc"
  referenceId     String              // Claim.id or InvoiceLineItem.id
  claimId         String?
  claim           Claim?              @relation(fields: [claimId], references: [id])
  amount          Float
  createdAt       DateTime            @default(now())

  @@index([subCategoryId])
  @@index([ledgerEntryId])
}

// =============================================================================
// CLUSTER 8 — TICKETING SYSTEM
// =============================================================================

model Ticket {
  id              String          @id @default(cuid())
  displayId       String          @unique @default("PENDING") // "TKT-0042"
  title           String
  description     String
  status          String          @default("open") // "open"|"in_progress"|"pending"|"resolved"|"closed"|"escalated"
  priority        String          @default("normal") // "low"|"normal"|"high"|"urgent"
  creatorId       String
  creator         User            @relation("TicketCreator", fields: [creatorId], references: [id])
  assigneeId      String?
  assignee        User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  department      String?         // "PR"|"HR"|"Finance"|"Marketing"|"IT"|"Management"
  originalDept    String?
  ticketType      String?         // "support"|"reschedule"|"missed_class"|"hr_complaint"|"disciplinary"|"it_change"|"finance_query"
  attachmentLink  String?
  category        String?
  routingStack    String?         // kept as string — XLSX parity (UJM decision)
  isConfidential  Boolean         @default(false) // HR complaint / disciplinary tickets
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  messages        TicketMessage[]
  history         TicketHistory[]

  @@index([creatorId])
  @@index([assigneeId])
  @@index([department, status])
  @@index([status, updatedAt])
  @@index([ticketType])
}

model TicketCategory {
  id          String    @id @default(cuid())
  name        String
  department  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, department])
}

model TicketMessage {
  id              String    @id @default(cuid())
  ticketId        String
  ticket          Ticket    @relation(fields: [ticketId], references: [id])
  senderId        String
  sender          User      @relation(fields: [senderId], references: [id])
  body            String
  isInternal      Boolean   @default(false)
  attachmentLink  String?
  createdAt       DateTime  @default(now())

  @@index([ticketId])
  @@index([senderId])
}

model TicketHistory {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id])
  actorId   String
  actor     User      @relation(fields: [actorId], references: [id])
  action    String
  meta      String?
  createdAt DateTime  @default(now())

  @@index([ticketId])
  @@index([actorId])
}

model TicketPermission {
  id                    String    @id @default(cuid())
  department            String    @unique
  canTargetStudent      Boolean   @default(true)
  canTargetParent       Boolean   @default(true)
  canTargetTeacher      Boolean   @default(true)
  canTargetAmbassador   Boolean   @default(true)
  canTargetCandidate    Boolean   @default(true)
  isInternalOnly        Boolean   @default(false)
  canTargetPR           Boolean   @default(true)
  canTargetIT           Boolean   @default(true)
  canTargetHR           Boolean   @default(true)
  canTargetFinance      Boolean   @default(true)
  canTargetMarketing    Boolean   @default(true)
  canTargetManagement   Boolean   @default(true)
  updatedAt             DateTime  @updatedAt
}

// =============================================================================
// CLUSTER 9 — ACADEMIC PROGRESS
// =============================================================================

// SyllabusItem tied to a specific Service/subject (not a raw string)
model SyllabusItem {
  id          String            @id @default(cuid())
  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id])
  chapterNum  String?
  title       String
  milestone   String            @default("core")
  order       Int
  isActive    Boolean           @default(true)

  progress    StudentProgress[]
  doubts      Doubt[]

  @@index([serviceId])
}

model StudentProgress {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation(fields: [studentId], references: [id])
  syllabusItemId  String
  syllabusItem    SyllabusItem  @relation(fields: [syllabusItemId], references: [id])
  completed       Boolean       @default(false)
  masteryPct      Int           @default(0)
  updatedAt       DateTime      @updatedAt

  @@unique([studentId, syllabusItemId])
  @@index([studentId])
}

model Doubt {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation(fields: [studentId], references: [id])
  syllabusItemId  String
  syllabusItem    SyllabusItem  @relation(fields: [syllabusItemId], references: [id])
  body            String
  response        String?
  status          String        @default("open") // "open"|"answered"|"closed"
  createdAt       DateTime      @default(now())

  @@index([studentId])
  @@index([syllabusItemId])
}

model MockResult {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id])
  score       Float
  maxScore    Float
  topic       String?
  takenAt     DateTime
  createdAt   DateTime  @default(now())

  @@index([studentId])
  @@index([serviceId])
}

model Assignment {
  id              String    @id @default(cuid())
  studentId       String
  student         User      @relation(fields: [studentId], references: [id])
  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id])
  title           String
  description     String?
  dueDate         DateTime
  status          String    @default("pending") // "pending"|"submitted"|"graded"|"missing"
  grade           String?
  submissionLink  String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([studentId])
  @@index([serviceId])
}

// =============================================================================
// CLUSTER 10 — HR & CANDIDATES
// =============================================================================

model Candidate {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  role                  String    // "teacher"|"TA"|"SM"|"HR"|"IT"|"Accounts"|"Marketing"
  status                String    @default("active") // "active"|"inactive"|"invited"|"interviewed"|"offered"|"rejected"|"onboarded"
  cvLink                String?   // XLSX: LINKS
  docsLink              String?
  notes                 String?   // XLSX: NOTES
  outreach              String?   // "LinkedIn"|"Instagram"|"careers_page"|"referral"
  skills                String?   // XLSX: SKILLS/SUBJECTS
  extraSkills           String?   // XLSX: EXTRA SKILLS/SUBJECTS
  qualifications        String?   // XLSX: QUALIFICATIONS
  expectedRate          String?   // XLSX: RATE
  timeZone              String?   // XLSX: TIME ZONE
  interviewTime         String?   // XLSX: INTERVIEW TIME e.g. "3:30 PM IST"
  startDate             DateTime? // XLSX: START DATE
  offerLetterStatus     String?   // XLSX: OFFER LETTER e.g. "Not Done"|"Sent"|"Accepted"
  gcrAccess             String?   // XLSX: GCR ACCESS
  classSchedule         String?   // XLSX: CLASS SCHEDULE
  workFolder            String?   // XLSX: WORK FOLDER
  interviewRequestedAt  DateTime? // XLSX: INTERVIEW DATE
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
}

// =============================================================================
// CLUSTER 11 — MEETINGS
// =============================================================================

model Meeting {
  id            String                @id @default(cuid())
  title         String
  dateTime      DateTime
  agenda        String?
  status        String                @default("scheduled") // "scheduled"|"confirmed"|"cancelled"|"rescheduled"|"completed"
  link          String?
  dept          String?
  meetingType   String?               // "dept_internal"|"townhall"|"interdept"|"management"
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())

  participants  MeetingParticipant[]
}

model MeetingParticipant {
  id          String    @id @default(cuid())
  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  rsvp        String    @default("pending") // "accepted"|"declined"|"pending"|"rescheduled"

  @@unique([meetingId, userId])
  @@index([userId])
  @@index([meetingId])
}

// =============================================================================
// CLUSTER 12 — AMBASSADOR PROGRAMME
// =============================================================================

model Referral {
  id                String              @id @default(cuid())
  referrerId        String
  referrer          User                @relation("Referrer", fields: [referrerId], references: [id])
  referredStudentId String?             // null until the referred person enrolls
  code              String
  status            String              @default("pending") // "pending"|"enrolled"|"expired"
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())

  earnings          AmbassadorEarning[]

  @@index([referrerId])
}

model AmbassadorDeliverable {
  id              String              @id @default(cuid())
  ambassadorId    String
  ambassador      AmbassadorProfile   @relation(fields: [ambassadorId], references: [id])
  title           String
  submissionLink  String?
  score           Float?
  feedback        String?
  status          String              @default("pending") // "pending"|"submitted"|"graded"
  submittedAt     DateTime?
  createdAt       DateTime            @default(now())

  @@index([ambassadorId])
}

model AmbassadorEarning {
  id              String              @id @default(cuid())
  ambassadorId    String
  ambassador      AmbassadorProfile   @relation(fields: [ambassadorId], references: [id])
  earningType     String              // "commission"|"allowance"
  amount          Float
  currency        String
  referralId      String?             // null for monthly allowance
  referral        Referral?           @relation(fields: [referralId], references: [id])
  payoutStatus    String              @default("pending") // "pending"|"approved"|"paid"
  earnedAt        DateTime
  createdAt       DateTime            @default(now())

  @@index([ambassadorId])
}

// =============================================================================
// CLUSTER 13 — CONTENT & MARKETING
// =============================================================================

// Dept-scoped content bank — links, docs, resources shared within a dept
model ContentBankItem {
  id            String    @id @default(cuid())
  dept          String    // "PR"|"HR"|"Finance"|"Marketing"|"IT"|"Management"
  name          String
  url           String
  description   String?
  dateAdded     DateTime  @default(now())
  addedByUserId String
  addedBy       User      @relation(fields: [addedByUserId], references: [id])
  isActive      Boolean   @default(true)

  @@index([dept])
}

model MarketingPost {
  id               String    @id @default(cuid())
  canvaLink        String?
  driveLink        String?
  caption          String?
  scheduledDate    DateTime
  contentType      String?   // "carousel"|"reel"|"post"|"story"|"vlog"|"documentary"|"alumni_story"|"staff_story"|"literature"
  status           String    @default("scheduled") // "scheduled"|"posted"|"missed"
  campaignTag      String?
  performanceNotes String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
}

// Lead log — Marketing generates, handed off to PR via Ticket (UJM)
model Lead {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  source        String?   // "google_ads"|"reddit"|"instagram"|"whatsapp_channel"|"telegram"|"school_visit"|"referral"
  status        String    @default("new")
  notes         String?
  passedToPR    Boolean   @default(false)
  passedAt      DateTime?
  prTicketId    String?   // Ticket.id created on handoff
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([source])
  @@index([passedToPR])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  targetRole  String    @default("all")
  targetDept  String?
  priority    String    @default("low")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model Recording {
  id        String    @id @default(cuid())
  title     String
  subject   String?
  videoUrl  String
  date      DateTime
  duration  String?
  category  String?
  createdAt DateTime  @default(now())
}

// =============================================================================
// CLUSTER 14 — STENCIL TABLES (XLSX PARITY — DO NOT RENAME COLUMNS)
// =============================================================================

model StudentStatus {
  id          String  @id @default(cuid())
  name        String  @unique
  definition  String?
}

model CanvaDesign {
  id    String    @id @default(cuid())
  name  String
  date  DateTime?
  link  String
}

model Booklet {
  id    String    @id @default(cuid())
  name  String
  date  DateTime?
  link  String
}

model GcrClassroom {
  id        String    @id @default(cuid())
  name      String
  link      String
  date      DateTime?
  serialNo  Int?
}

// XLSX parity: addedToCalendar and addedToCalendar2 kept exactly as named (UJM decision)
model BacklogItem {
  id                String    @id @default(cuid())
  serialNo          Int?
  importance        String?
  addedToCalendar   String?
  dateAdded         DateTime?
  addedToCalendar2  String?
  date              DateTime?
  additionalTask    String?
  event             String?
  desc              String?
  startTime         String?
  endTime           String?
  durationHours     Float?
  location          String?
  tag               String?
  nextSteps         String?
}

model SprintItem {
  id                String    @id @default(cuid())
  serialNo          Int?
  importance        String?
  addedToCalendar   String?
  dateAdded         DateTime?
  addedToCalendar2  String?
  date              DateTime?
  additionalTask    String?
  event             String?
  desc              String?
  startTime         String?
  endTime           String?
  durationHours     Float?
  location          String?
  tag               String?
  nextSteps         String?
}

// Currency rates — renamed cols from old schema for clarity
model CurrencyRate {
  id            String    @id @default(cuid())
  fromCurrency  String    @unique // "SAR"|"GBP"|"USD"|"INR"|"PKR"|"MYR"|"AED"|"SGD"|"BDT"|"BHD"|"SCR"
  rate          Float     // 1 unit fromCurrency = X INR
  reverseRate   Float     // 1 INR = X units fromCurrency
  updatedAt     DateTime  @updatedAt
}

// Renamed from MessageTemplate → TextFormat (XLSX: Text_Formats sheet)
model TextFormat {
  id              String    @id @default(cuid())
  name            String    @unique // "DC Student Payment Acknowledgement" etc.
  text            String    // XLSX: primary message text
  alternateText1  String?   // XLSX: ALTERNATE TEXT #1
  use             String?   // XLSX: USE — context/trigger
  date            DateTime?
  createdAt       DateTime  @default(now())
}

// AccessLog — deferred to later (Q4 decision). Kept minimal for now.
model AccessLog {
  id            String    @id @default(cuid())
  staffName     String
  toolName      String
  credential    String?
  dateGranted   DateTime  @default(now())
  revoked       Boolean   @default(false)
  notes         String?
}
