.env.local
.env.production
node_modules/
.next/

# Local page screenshots (see scripts/snapshot.mjs) — not part of the repo
snapshots/
dev.db
sandbox.db
*.db-journal
*.db-shm
*.db-wal
tsconfig.tsbuildinfo
build_log*.txt
redo_db.log

# Cookie / session files
cookies.txt
cookies-test.txt
jar

# Windows Zone.Identifier junk
*Zone.Identifier*

# Secrets / keys
planning/keys.md

# Compiled scratch artifacts
scratch/*.cjs
scratch/*.mjs

# Secrets / planning sensitive files
planning/keys.md
planning/PORTAL_CREDENTIALS.md
planning/invoice generator/
planning/trash/

# Real data exports
data/

# Generated clients — only exclude sandbox (large wasm); prisma client is regenerated via postinstall
src/generated/sandbox/
prisma/generated/
.vercel

# Reference-only copies (v6, dcp1-app) — not needed for v7 (repo root) or Vercel
builds

# Local Supabase data backups — contains real PII (names, phone numbers,
# passport/IC numbers). This repo is public — never commit these.
/backups/

# NPC-sim persona/script/state files — each one embeds that NPC's own
# live API key (a real Bearer token), same reason as planning/keys.md above.
/lib/npc/state/

# npc-browser: the browser-automation Student/Teacher/Parent NPC trio.
# state/credentials.json holds real plaintext login passwords for the
# ZZZ_AGENT_* accounts, and state/rendezvous.json is per-run coordination
# state — neither belongs in git.
/lib/npc-browser/state/
# TKT-0146: logs/ was missed the first time (only state/ was covered) —
# real cron output, low sensitivity but still shouldn't be committed.
/lib/npc-browser/logs/

# exam-grader prototype: samples/ can hold real uploaded student work
# (handwritten scripts, real names) for manual testing — this repo is
# public, real student PII never belongs in it, same reasoning as
# /backups/ above.
/prototypes/exam-grader/samples/
# Real OPENROUTER_API_KEY -- never commit.
/prototypes/exam-grader/.env
/prototypes/quiz-digitizer/.env
# Same reasoning as exam-grader/samples/ above -- real, third-party
# question papers used for manual testing don't belong in a public repo.
/prototypes/quiz-digitizer/samples/
# mcq-digitizer has no .env (no LLM, no API key) but samples/ could still
# hold a real user-provided MCQ paper later -- same reasoning as above.
/prototypes/mcq-digitizer/samples/

# Redis snapshot file (redis-server writes this to its cwd) — debris from
# running the local redis-server used by the YouTube-transcript tool.
dump.rdb
